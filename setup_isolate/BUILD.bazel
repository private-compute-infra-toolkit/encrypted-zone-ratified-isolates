load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":isolate_package.bzl", "isolate_package")

exports_files([
    ".rustfmt.toml",
    "buf.yaml",
])

rust_binary(
    name = "setup_isolate",
    srcs = ["main.rs"],
    visibility = ["//visibility:public"],
    deps = [
        "//service:setup_isolate_lib",
        "//v1:setup_isolate_rust",
        "//v1:setup_service",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:log",
        "@crates//:tokio",
        "@privacy-sandbox-ez-sdk//core/rust:core",
    ],
)

isolate_package(
    base_name = "setup_isolate",
    binary = ":setup_isolate",
)

# PES can trust several root certificates at once, e.g. during a key rotation.
# All acceptable certificates for an environment are kept in a single PEM file.
filegroup(
    name = "pes_root_certs_prod",
    srcs = ["resources/pcit_root_certs/prod/pes-cert/root_certificates.pem"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pes_root_certs_staging",
    srcs = ["resources/pcit_root_certs/staging/pes-cert/root_certificates.pem"],
    visibility = ["//visibility:public"],
)

# Tests use the prod-signed endorsements; the staging certificate is added to
# cover the case where only one of the trusted certificates matches.
filegroup(
    name = "pes_root_certs_test",
    srcs = [
        ":pes_root_certs_prod",
        ":pes_root_certs_staging",
    ],
    visibility = ["//visibility:public"],
)
