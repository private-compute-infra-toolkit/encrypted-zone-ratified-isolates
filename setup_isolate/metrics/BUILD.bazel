load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "metrics",
    srcs = ["src/metrics.rs"],
    deps = [
        "//v1:setup_isolate_rust",
        "@crates//:opentelemetry",
        "@privacy-sandbox-ez-sdk//enforcer/v1:ez_mtls_rust",
    ],
)

rust_test(
    name = "metrics_test",
    size = "small",
    srcs = ["test/metrics_test.rs"],
    deps = [
        ":metrics",
        "//v1:setup_isolate_rust",
        "@crates//:opentelemetry",
        "@crates//:opentelemetry_sdk",
        "@privacy-sandbox-ez-sdk//enforcer/v1:ez_mtls_rust",
    ],
)
